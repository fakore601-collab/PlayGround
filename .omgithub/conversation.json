color:var(--muted); font-size:15px; padding-bottom:5px; }\n    .remaining strong { color:var(--orange); margin-left:5px; }\n    .composer { background:var(--panel); border:1px solid #303136; border-radius:18px; padding:10px; display:grid; grid-template-columns:minmax(180px,1fr) 145px 48px; gap:8px; box-shadow:0 18px 45px rgba(0,0,0,.16); }\n    .composer input, .composer select { width:100%; height:48px; border:0; outline:none; border-radius:12px; color:var(--text); }\n    .composer input { background:transparent; padding:0 14px; direction:rtl; }\n    .composer input::placeholder { color:#77777d; }\n    .composer select { background:#292a2e; padding:0 12px; border:1px solid #34353a; cursor:pointer; }\n    .add { border:0; border-radius:12px; background:var(--orange); color:#1d1711; font-size:27px; font-weight:700; cursor:pointer; transition:.2s; }\n    .add:hover { filter:brightness(1.08); transform:translateY(-1px); }\n    .filters { display:flex; gap:8px; align-items:center; margin:22px 0 14px; flex-wrap:wrap; }\n    .filters button { height:38px; padding:0 13px; border-radius:999px; border:1px solid #35363a; background:var(--panel); color:#aaa9ae; cursor:pointer; }\n    .filters button.active { background:#fff0df; border-color:#fff0df; color:#302319; }\n    .status-filter { margin-right:auto; }\n    .status-filter select { height:38px; min-width:130px; border:1px solid #35363a; border-radius:999px; background:var(--panel); color:#c5c4c8; padding:0 12px; outline:none; }\n    .list { display:flex; flex-direction:column; gap:9px; }\n    .task { min-height:68px; display:grid; grid-template-columns:34px 1fr auto 36px; align-items:center; gap:10px; background:var(--panel); border:1px solid #303136; border-radius:14px; padding:10px 12px 10px 8px; transition:.18s; }\n    .task:hover { border-color:#42434a; transform:translateY(-1px); }\n    .check { width:21px; height:21px; border:2px solid #66676d; border-radius:50%; background:transparent; cursor:pointer; padding:0; }\n    .task.done .check { background:var(--orange); border-color:var(--orange); box-shadow:inset 0 0 0 5px var(--panel); }\n    .task.done .task-name { color:#77787d; text-decoration:line-through; }\n    .task-name { font-size:16px; }\n    .badge { border-radius:999px; padding:6px 10px; font-size:12px; font-weight:700; }\n    .badge.work { color:#ffc56c; background:rgba(245,167,66,.13); }\n    .badge.study { color:#aab8ef; background:rgba(125,147,217,.14); }\n    .badge.personal { color:#89dbab; background:rgba(97,201,139,.14); }\n    .delete { width:32px; height:32px; border:0; border-radius:9px; background:transparent; color:#77787d; cursor:pointer; font-size:17px; }\n    .delete:hover { background:#34353a; color:#fff; }\n    .empty { text-align:center; color:#77787d; padding:55px 10px; border:1px dashed #35363a; border-radius:14px; }\n    @media (max-width:600px) {\n      .app { width:min(100% - 20px, 920px); padding-top:24px; }\n      h1 { font-size:31px; }\n      .header { margin-bottom:18px; }\n      .composer { grid-template-columns:minmax(0,1fr) 110px 46px; border-radius:15px; }\n      .composer input { padding:0 8px; }\n      .composer select { font-size:13px; }\n      .filters { gap:6px; }\n      .filters button { height:36px; padding:0 10px; font-size:13px; }\n      .status-filter { width:100%; margin:4px 0 0; }\n      .status-filter select { width:100%; }\n      .task { grid-template-columns:30px minmax(0,1fr) auto 34px; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"app\">\n    <header class=\"header\">\n      <h1>مهامي</h1>\n      <div class=\"remaining\"><strong id=\"remainingCount\">0</strong> مهام متبقية</div>\n    </header>\n\n    <form class=\"composer\" id=\"taskForm\">\n      <input id=\"taskInput\" type=\"text\" maxlength=\"120\" placeholder=\"ما الذي تريد إنجازه؟\" autocomplete=\"off\" />\n      <select id=\"categoryInput\" aria-label=\"التصنيف\">\n        <option value=\"work\">عمل</option>\n        <option value=\"study\">دراسة</option>\n        <option value=\"personal\">شخصي</option>\n      </select>\n      <button class=\"add\" type=\"submit\" aria-label=\"إضافة مهمة\">+</button>\n    </form>\n\n    <nav class=\"filters\">\n      <button type=\"button\" class=\"active\" data-category=\"all\">الكل</button>\n      <button type=\"button\" data-category=\"work\">عمل</button>\n      <button type=\"button\" data-category=\"study\">دراسة</button>\n      <button type=\"button\" data-category=\"personal\">شخصي</button>\n      <div class=\"status-filter\">\n        <select id=\"statusFilter\" aria-label=\"حالة المهمة\">\n          <option value=\"all\">كل الحالات</option>\n          <option value=\"active\">غير مكتملة</option>\n          <option value=\"done\">مكتملة</option>\n        </select>\n      </div>\n    </nav>\n\n    <section class=\"list\" id=\"taskList\"></section>\n  </main>\n\n  <script>\n    const labels = { work:'عمل', study:'دراسة', personal:'شخصي' };\n    const listEl = document.getElementById('taskList');\n    const input = document.getElementById('taskInput');\n    const categoryInput = document.getElementById('categoryInput');\n    const statusFilter = document.getElementById('statusFilter');\n    let categoryFilter = 'all';\n    let tasks = JSON.parse(localStorage.getItem('todo-tasks-v1') || '[]');\n\n    if (!tasks.length) {\n      tasks = [\n        { id:crypto.randomUUID(), name:'إنهاء تقرير المشروع', category:'work', done:false },\n        { id:crypto.randomUUID(), name:'مراجعة درس البرمجة', category:'study', done:false },\n        { id:crypto.randomUUID(), name:'شراء مستلزمات المنزل', category:'personal', done:true }\n      ];\n      save();\n    }\n\n    function save() { localStorage.setItem('todo-tasks-v1', JSON.stringify(tasks)); }\n\n    function escapeHtml(value) {\n      const div = document.createElement('div');\n      div.textContent = value;\n      return div.innerHTML;\n    }\n\n    function render() {\n      const status = statusFilter.value;\n      const visible = tasks.filter(t => (categoryFilter === 'all' || t.category === categoryFilter) && (status === 'all' || (status === 'done' ? t.done : !t.done)));\n      document.getElementById('remainingCount').textContent = tasks.filter(t => !t.done).length;\n\n      if (!visible.length) {\n        listEl.innerHTML = '<div class=\"empty\">لا توجد مهام مطابقة للعرض</div>';\n        return;\n      }\n\n      listEl.innerHTML = visible.map(task => `\n        <article class=\"task ${task.done ? 'done' : ''}\" data-id=\"${task.id}\">\n          <button class=\"check\" aria-label=\"${task.done ? 'إلغاء الإكمال' : 'تحديد كمكتملة'}\"></button>\n          <div class=\"task-name\">${escapeHtml(task.name)}</div>\n          <span class=\"badge ${task.category}\">${labels[task.category]}</span>\n          <button class=\"delete\" aria-label=\"حذف المهمة\">×</button>\n        </article>\n      `).join('');\n    }\n\n    document.getElementById('taskForm').addEventListener('submit', e => {\n      e.preventDefault();\n      const name = input.value.trim();\n      if (!name) { input.focus(); return; }\n      tasks.unshift({ id:crypto.randomUUID(), name, category:categoryInput.value, done:false });\n      input.value = '';\n      save();\n      render();\n    });\n\n    listEl.addEventListener('click', e => {\n      const taskEl = e.target.closest('.task');\n      if (!taskEl) return;\n      const id = taskEl.dataset.id;\n      if (e.target.classList.contains('check')) {\n        tasks = tasks.map(t => t.id === id ? {...t, done:!t.done} : t);\n      }\n      if (e.target.classList.contains('delete')) {\n        tasks = tasks.filter(t => t.id !== id);\n      }\n      save();\n      render();\n    });\n\n    document.querySelectorAll('[data-category]').forEach(button => {\n      button.addEventListener('click', () => {\n        categoryFilter = button.dataset.category;\n        document.querySelectorAll('[data-category]').forEach(b => b.classList.remove('active'));\n        button.classList.add('acti